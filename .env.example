# ============================================================
#  vidrelay — 环境变量示例
#  复制为 .env 并填入真实值。.env 已被 .gitignore 忽略。
#  永远不要把填好的 .env 提交进仓库。
# ============================================================

# ---------- YouTube（官方 Data API v3）----------
# 在 Google Cloud Console 建项目 → 启用 YouTube Data API v3 → 创建 OAuth 客户端 ID
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# ---------- Dailymotion（官方 Graph API）----------
# 在 Dailymotion 开发者后台创建 API key
DAILYMOTION_CLIENT_ID=
DAILYMOTION_CLIENT_SECRET=
DAILYMOTION_REDIRECT_URI=http://localhost:3000/callback

# ---------- TikTok（官方 Content Posting API）----------
# 需要应用通过审核，scope: video.publish
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/tiktok/callback

# ---------- 运行参数 ----------
# 凭证目录（相对仓库根）。该目录已被 .gitignore 忽略。
VIDRELAY_SECRETS_DIR=secrets

# 国内组执行前强制校验出口 IP 归属。设为 0 可关闭（不建议）。
VIDRELAY_ENFORCE_NETGUARD=1

# 出口 IP 归属查询服务（需返回国家代码）
VIDRELAY_IP_LOOKUP_URL=https://ipinfo.io/json
