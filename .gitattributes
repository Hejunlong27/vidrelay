# 统一换行符，避免跨平台 diff 噪音
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.mov binary
*.zip binary
*.whl binary

# 生成物不参与语言统计
tests/fixtures/*.yaml linguist-language=YAML
